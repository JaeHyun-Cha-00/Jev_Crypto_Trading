# One container for a public host (render.yaml): the API also serves the built
# dashboard, behind DASHBOARD_PASSWORD. docker compose keeps using Dockerfile
# and web/Dockerfile (nginx) on localhost.
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    JEVTRADE_WEB_DIR=/app/web

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --upgrade pip && pip install '.[api]'
COPY config ./config
COPY --from=web /web/dist ./web

RUN useradd --create-home --uid 1000 jev && mkdir -p data reports && chown -R jev:jev data reports
USER jev

# The host sets $PORT; 8000 otherwise.
CMD ["python", "-m", "jevtrade.api", "--host", "0.0.0.0"]

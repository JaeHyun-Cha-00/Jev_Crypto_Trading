# Copy to .env and fill in. .env is gitignored. No exchange keys are used anywhere.
# Only needed when decision.model is jev (config/default.yaml):
# OPENROUTER_API_KEY=
# The paper loop refuses to call the paid Jev API unless this is 1:
# JEVTRADE_ALLOW_LIVE_MODEL=0
# The API's "Jev forward log" reads the data-log branch from GitHub. Needed if the
# repo is private (read-only "Contents" access is enough); also lifts rate limits:
# GITHUB_TOKEN=
